//Buscar en todos los subdocumentos de persona el nombre :MARK
db.companies.find({
   relationships:{
    $elemMatch:{
        "person.first_name":"Mark"
    }
   }
},
{
    //Projection
    name:1,
    relationships:1
}
).count()//523