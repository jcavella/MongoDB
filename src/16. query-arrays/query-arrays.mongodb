//$elemenMatch:coincida exactamente los que contienen un elemento
//Documentos con elemento del array product = xyx
//db.survey.find({results:{$elemMatch:{product:"xyz"}}})

//Documentos con elemento del array product = xyx 
// y score mayor o igual a 7
db.survey.find({
    results:{
        $elemMatch:{
            product:"xyz",
            score:{$gte:7}
        }}})