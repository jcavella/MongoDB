//Incluir conteo de habitaciones con Wifi
db.listingsAndReviews.aggregate([
    {$match: { amenities: "Wifi"}}, //find
    {$project: {address: 1}}, //project
    {$group: {_id:"$address.country", count: {$sum:1}}} //Agrupaciones por pais
])
